generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Player {
  id            String         @id @default(cuid())
  name          String
  phone         String?
  isExempt      Boolean        @default(false)
  positions     String         @default("")
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  deletedAt     DateTime?
  matchPlayers  MatchPlayer[]
  payments      Payment[]
  playerRatings PlayerRating[]
}

model Match {
  id            String         @id @default(cuid())
  date          DateTime
  location      String?
  totalCost     Float
  notes         String?
  cancelledAt   DateTime?
  goalkeeperFree Boolean       @default(false)
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  team1Name     String?
  team2Name     String?
  deletedAt     DateTime?
  matchPlayers  MatchPlayer[]
  playerRatings PlayerRating[]
}

model MatchPlayer {
  id           String  @id @default(cuid())
  matchId      String
  playerId     String
  amountOwed   Float
  isGoalkeeper Boolean @default(false)
  team         Int?
  player       Player  @relation(fields: [playerId], references: [id], onDelete: Cascade)
  match        Match   @relation(fields: [matchId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId])
}

model PlayerRating {
  id        String   @id @default(cuid())
  matchId   String
  playerId  String
  raterName String
  rating    Int
  createdAt DateTime @default(now())
  match     Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  player    Player   @relation(fields: [playerId], references: [id], onDelete: Cascade)

  @@unique([matchId, playerId, raterName])
}

model Payment {
  id          String    @id @default(cuid())
  playerId    String
  amount      Float
  date        DateTime  @default(now())
  notes       String?
  isKasa      Boolean   @default(false)
  createdAt   DateTime  @default(now())
  cancelledAt DateTime?
  deletedAt   DateTime?
  player      Player    @relation(fields: [playerId], references: [id], onDelete: Cascade)
}

model User {
  id                  String    @id @default(cuid())
  username            String    @unique
  password            String
  failedLoginAttempts Int       @default(0)
  lockedUntil         DateTime?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt
}
