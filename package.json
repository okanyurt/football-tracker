{
  "name": "football-tracker",
  "version": "1.1.5",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,client -c green,cyan \"npm run dev:api\" \"node scripts/start-client-after-api.mjs\"",
    "dev:api": "API_PORT=3001 node --experimental-strip-types src/server/index.ts",
    "dev:client": "vite",
    "build": "vite build",
    "preview": "vite preview --host 0.0.0.0",
    "postinstall": "prisma generate",
    "start": "NODE_ENV=production node --experimental-strip-types src/server/index.ts",
    "db:push": "prisma db push",
    "db:studio": "prisma studio",
    "db:seed": "node --experimental-strip-types prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "5.22.0",
    "@tailwindcss/postcss": "4.2.4",
    "@types/bcryptjs": "2.4.6",
    "bcryptjs": "3.0.3",
    "cookie-parser": "1.4.7",
    "date-fns": "3.6.0",
    "dotenv": "17.2.3",
    "express": "5.2.1",
    "jose": "6.2.2",
    "jspdf": "4.2.1",
    "jspdf-autotable": "5.0.7",
    "lucide-react": "1.8.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "react-router-dom": "7.14.2",
    "tailwindcss": "4.2.4",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@types/cookie-parser": "1.4.10",
    "@types/express": "5.0.6",
    "@types/node": "20",
    "@types/react": "19",
    "@types/react-dom": "19",
    "@vitejs/plugin-react": "6.0.1",
    "concurrently": "9.2.1",
    "postcss": "8",
    "prisma": "5.22.0",
    "tsx": "4.21.0",
    "typescript": "5",
    "vite": "8.0.10"
  }
}
